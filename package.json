{
  "name": "@zhanguym/chatroom",
  "version": "1.2.0",
  "type": "module",
  "description": "Local MCP runtime for ChatGPT with workspace, process, Cloud, and WebUI controls.",
  "bin": {
    "chatroom": "dist/cli/index.js"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "format": "prettier --write \"src/**/*.{ts,vue,css,html}\" \"test/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,html}\" \"test/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,ts}\"",
    "dev": "node --conditions=chatroom-source --watch --import tsx src/cli/index.ts serve",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.build.json && node scripts/finalize-build.mjs",
    "build": "npm run clean && npm run build:web && npm run build:server",
    "typecheck:server": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "vue-tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:server && npm run typecheck:web",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test": "node scripts/run-tests.mjs",
    "check": "npm run format:check && npm run typecheck && npm run check:architecture && npm test && npm run build",
    "start": "node dist/cli/index.js serve",
    "release": "npm publish --tag latest --access public",
    "prepack": "npm run check",
    "build:native:macos": "node scripts/build-native-macos.mjs",
    "build:native:windows": "node scripts/build-native-windows.mjs",
    "build:native:linux": "node scripts/build-native-linux.mjs",
    "clean:all": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "postinstall": "node scripts/ensure-pty-helper.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@simplewebauthn/server": "13.3.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "pdfjs-dist": "6.4.299",
    "ws": "^8.18.3",
    "zod": "^4.0.17"
  },
  "optionalDependencies": {
    "node-datachannel": "^0.33.4",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@simplewebauthn/browser": "^13.3.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.2.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "prettier": "^3.9.6",
    "simple-icons": "^15.22.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9",
    "vuetify": "^4.1.9"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "license": "Apache-2.0",
  "homepage": "https://chatroomcp.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gymZJ/ChatRoom.git"
  },
  "bugs": {
    "url": "https://github.com/gymZJ/ChatRoom/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "files": [
    "dist",
    "assets",
    "chatroom.config.example.json",
    "scripts/ensure-pty-helper.mjs"
  ],
  "imports": {
    "#app/*": {
      "chatroom-source": "./src/app/*.ts",
      "default": "./dist/app/*.js"
    },
    "#auth/*": {
      "chatroom-source": "./src/auth/*.ts",
      "default": "./dist/auth/*.js"
    },
    "#cli/*": {
      "chatroom-source": "./src/cli/*.ts",
      "default": "./dist/cli/*.js"
    },
    "#config/*": {
      "chatroom-source": "./src/config/*.ts",
      "default": "./dist/config/*.js"
    },
    "#core/*": {
      "chatroom-source": "./src/core/*.ts",
      "default": "./dist/core/*.js"
    },
    "#infrastructure/*": {
      "chatroom-source": "./src/infrastructure/*.ts",
      "default": "./dist/infrastructure/*.js"
    },
    "#mcp/*": {
      "chatroom-source": "./src/mcp/*.ts",
      "default": "./dist/mcp/*.js"
    },
    "#operations/*": {
      "chatroom-source": "./src/operations/*.ts",
      "default": "./dist/operations/*.js"
    },
    "#plugins/*": {
      "chatroom-source": "./src/plugins/*.ts",
      "default": "./dist/plugins/*.js"
    },
    "#presentation/*": {
      "chatroom-source": "./src/presentation/*.ts",
      "default": "./dist/presentation/*.js"
    }
  }
}
